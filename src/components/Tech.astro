---
import { getIcon, techLabel } from '../lib/icons';

interface Props {
  /** simple-icons slug or plain name. */
  name: string;
  /** Overrides the displayed text (default: the icon's title, or the name). */
  label?: string;
}
const { name, label } = Astro.props;
const icon = getIcon(name);
---

<span class="chip">
  {icon && (
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d={icon.path} />
    </svg>
  )}
  {label ?? techLabel(name)}
</span>
