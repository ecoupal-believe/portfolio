---
import ArchDiagram from './ArchDiagram.astro';
import Tech from './Tech.astro';
import { useTranslations, pick, type Lang } from '../i18n/utils';
import { missionGroups } from '../data/missions';
import { resolveItem } from '../data/stack';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// 24×24 stroke glyphs for diagram nodes (referenced as #dg-i-<name>).
const icons: Record<string, string> = {
  code: '<path d="M8 7l-5 5 5 5M16 7l5 5-5 5"/>',
  check: '<path d="M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/>',
  pipe: '<circle cx="5" cy="12" r="2.5"/><circle cx="19" cy="6" r="2.5"/><circle cx="19" cy="18" r="2.5"/><path d="M7.5 12h4l5-6M11.5 12l5 6"/>',
  eye: '<path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z"/><circle cx="12" cy="12" r="3"/>',
  play: '<path d="M7 4.5l12 7.5-12 7.5z"/>',
  org: '<rect x="9" y="3" width="6" height="5" rx="1"/><rect x="3" y="16" width="6" height="5" rx="1"/><rect x="15" y="16" width="6" height="5" rx="1"/><path d="M12 8v4M6 16v-4h12v4"/>',
  box: '<path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/><path d="M4 7.5l8 4.5 8-4.5M12 12v9"/>',
  net: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"/>',
  container: '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V4h8v3M7 11v5M11 11v5M15 11v5"/>',
  registry: '<rect x="3" y="4" width="18" height="5" rx="1"/><path d="M5 9v10h14V9M10 13h4"/>',
  git: '<circle cx="6" cy="5.5" r="2.5"/><circle cx="6" cy="18.5" r="2.5"/><circle cx="18" cy="8" r="2.5"/><path d="M6 8v8M18 10.5c0 4-5.5 3-10.3 6"/>',
  sync: '<path d="M20 11a8 8 0 0 0-14.5-4.5M4 13a8 8 0 0 0 14.5 4.5"/><path d="M5 3v4h4M19 21v-4h-4"/>',
  cluster: '<path d="M12 2.5l8.2 4.75v9.5L12 21.5l-8.2-4.75v-9.5z"/><circle cx="12" cy="12" r="3"/>',
  puzzle: '<rect x="3.5" y="3.5" width="7" height="7" rx="1"/><rect x="13.5" y="13.5" width="7" height="7" rx="1"/><path d="M10.5 7H17v6.5M13.5 17H7v-6.5"/>',
  db: '<ellipse cx="12" cy="5.5" rx="7.5" ry="2.5"/><path d="M4.5 5.5v13c0 1.4 3.4 2.5 7.5 2.5s7.5-1.1 7.5-2.5v-13M4.5 12c0 1.4 3.4 2.5 7.5 2.5s7.5-1.1 7.5-2.5"/>',
  msg: '<path d="M4 5h16v11H9.5L4 20z"/><path d="M8 9.5h8M8 12.5h5"/>',
  bucket: '<path d="M4 6.5h16l-2 13.5H6z"/><ellipse cx="12" cy="6.5" rx="8" ry="2.5"/>',
  user: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/>',
  shield: '<path d="M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6z"/>',
  lb: '<circle cx="5" cy="12" r="2.5"/><circle cx="19" cy="5" r="2"/><circle cx="19" cy="12" r="2"/><circle cx="19" cy="19" r="2"/><path d="M7.5 12H17M7 10.5l10-5M7 13.5l10 5"/>',
  proxy: '<path d="M4 8h14l-3.5-3.5M20 16H6l3.5 3.5"/>',
  key: '<circle cx="8" cy="15" r="4.5"/><path d="M11.2 11.8L20 3M16 7l3 3M14 9l2 2"/>',
  gauge: '<path d="M3.5 17a8.5 8.5 0 1 1 17 0"/><path d="M12 17l4.5-6"/><circle cx="12" cy="17" r="1.2"/>',
  pause: '<rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>',
  bell: '<path d="M6 16v-5a6 6 0 0 1 12 0v5l1.5 2h-15z"/><path d="M10 20.5a2 2 0 0 0 4 0"/>',
  cloud: '<path d="M7 18.5h10a4 4 0 0 0 .7-7.94A6 6 0 0 0 6.3 9.6 4.5 4.5 0 0 0 7 18.5z"/>',
  router: '<rect x="3" y="13" width="18" height="7" rx="2"/><path d="M7 16.5h.01M11 16.5h.01M12 13V9M8.5 6.5a5 5 0 0 1 7 0M6 4a8.5 8.5 0 0 1 12 0"/>',
  link: '<path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/>',
  building: '<rect x="4" y="3" width="16" height="18" rx="1"/><path d="M8 7h2M14 7h2M8 11h2M14 11h2M8 15h2M14 15h2M10 21v-3h4v3"/>',
};
---

<section class="section" id="architecture">
  <svg class="dg-sprite" aria-hidden="true" focusable="false">
    {
      Object.entries(icons).map(([name, body]) => (
        <symbol id={`dg-i-${name}`} viewBox="0 0 24 24" set:html={body} />
      ))
    }
  </svg>

  <div class="wrap">
    <div class="section-head rv">
      <span class="eyebrow">01 / {t.missions.title}</span>
      <h2>{t.missions.title}</h2>
      <p>{t.missions.intro}</p>
    </div>

    {
      missionGroups.map((g, gi) => (
        <div class="group">
          <div class="group-head rv">
            <h3>{pick(lang, g.label)}</h3>
            <p>{pick(lang, g.intro)}</p>
          </div>
          <div class="cards">
            {g.missions.map((m, i) => (
              <article class="mcard rv">
                <div class="top">
                  <span class="tag">{pick(lang, m.tag)}</span>
                  <span class="sector">{pick(lang, m.sector)}</span>
                </div>
                <h4>{pick(lang, m.title)}</h4>
                <p class="text">{pick(lang, m.text)}</p>
                <figure>
                  <div class="scroll-x">
                    <ArchDiagram diagram={m.diagram} lang={lang} uid={`${lang}-${gi}-${i}`} />
                  </div>
                  <figcaption>{pick(lang, m.diagram.caption)}</figcaption>
                </figure>
                <div class="chips">
                  {m.chips.map((c) => (
                    <Tech {...resolveItem(c, lang)} />
                  ))}
                </div>
              </article>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .dg-sprite {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
  .group + .group {
    margin-top: clamp(48px, 7vw, 72px);
  }
  .group-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 14px;
    margin-bottom: 18px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
  }
  .group-head h3 {
    font-size: clamp(20px, 2.4vw, 24px);
  }
  .group-head p {
    color: var(--muted);
    font-size: 15px;
  }
  .cards {
    display: grid;
    gap: 24px;
  }
  .mcard {
    min-width: 0; /* let .scroll-x scroll instead of the grid item growing to the diagram's min-width */
    padding: clamp(20px, 3.5vw, 32px);
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) + 4px);
    background: var(--surface);
    box-shadow: var(--shadow);
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
  }
  .tag {
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.04em;
    color: var(--accent);
    background: var(--accent-soft);
    padding: 3px 10px;
    border-radius: 999px;
  }
  .sector {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--faint);
  }
  h4 {
    margin: 14px 0 0;
    font-family: var(--display);
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-size: clamp(21px, 2.6vw, 26px);
  }
  .text {
    margin-top: 10px;
    color: var(--muted);
    max-width: 72ch;
  }
  figure {
    margin: 24px 0 0;
  }
  .scroll-x {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 4px;
  }
  figcaption {
    margin-top: 10px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--faint);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 18px;
  }
</style>
