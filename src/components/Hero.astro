---
import { useTranslations, type Lang } from '../i18n/utils';
import { profile } from '../data/profile';
import { projects } from '../data/projects';
import { stack, resolveItem } from '../data/stack';
import { asset } from '../lib/url';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const cv = profile.cv[lang];
const techCount = new Set(stack.flatMap((g) => g.items.map((i) => resolveItem(i, lang).label ?? resolveItem(i, lang).name))).size;
const stats = [
  { n: profile.yearsOfExperience, label: t.hero.stats.years, suffix: '+' },
  { n: projects.length, label: t.hero.stats.projects },
  { n: techCount, label: t.hero.stats.techs },
];
---

<section class="hero">
  <div class="wrap">
    <p class="kicker rv"><span class="dot" aria-hidden="true"></span>{t.hero.kicker}</p>
    <h1 class="rv" style="--d:80ms">{profile.name}</h1>
    <p class="role rv" style="--d:160ms">{t.hero.role}</p>
    <p class="pitch rv" style="--d:240ms">{t.hero.pitch}</p>
    <div class="cta rv" style="--d:320ms">
      <a class="btn btn-primary" href="#contact">{t.hero.ctaContact}</a>
      {cv && <a class="btn" href={asset(cv)} download>{t.hero.ctaCv} <span aria-hidden="true">↓</span></a>}
    </div>
    <dl class="stats rv" style="--d:400ms">
      {
        stats.map((s) => (
          <div>
            <dt>{s.label}</dt>
            <dd>
              <span data-count={s.n}>{s.n}</span>
              {s.suffix}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .hero {
    padding: clamp(72px, 14vw, 150px) 0 clamp(56px, 8vw, 96px);
  }
  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--muted);
    border: 1px solid var(--line);
    background: var(--surface);
    padding: 6px 12px;
    border-radius: 999px;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 var(--accent);
    animation: pulse 2.4s infinite;
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 60%, transparent); }
    70%, 100% { box-shadow: 0 0 0 10px transparent; }
  }
  h1 {
    margin-top: 28px;
    font-size: clamp(48px, 11vw, 112px);
    font-weight: 700;
    letter-spacing: -0.045em;
  }
  .role {
    margin-top: 14px;
    font-family: var(--display);
    font-size: clamp(22px, 3.6vw, 34px);
    color: var(--accent);
    font-weight: 500;
  }
  .pitch {
    margin-top: 22px;
    max-width: 58ch;
    font-size: clamp(17px, 2vw, 19px);
    color: var(--muted);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 64px 0 0;
    border-top: 1px solid var(--line);
    max-width: 640px;
  }
  .stats div {
    display: flex;
    flex-direction: column-reverse;
    gap: 2px;
    padding: 18px 16px 0 0;
  }
  dd {
    margin: 0;
    font-family: var(--display);
    font-size: clamp(32px, 6vw, 46px);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  dt {
    font-size: 13.5px;
    color: var(--muted);
  }
</style>
