---
import { useTranslations, type Lang } from '../i18n/utils';
import { profile } from '../data/profile';
import { projects } from '../data/projects';
import { missionGroups } from '../data/missions';
import { stack, resolveItem } from '../data/stack';
import { asset } from '../lib/url';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const cv = profile.cv[lang];
const techCount = new Set(stack.flatMap((g) => g.items.map((i) => resolveItem(i, lang).label ?? resolveItem(i, lang).name))).size;
const stats = [
  { n: profile.yearsOfExperience, label: t.hero.stats.years, suffix: '+', href: '#timeline' },
  { n: missionGroups.reduce((sum, g) => sum + g.missions.length, 0), label: t.hero.stats.underTheHood, href: '#architecture' },
  { n: projects.length, label: t.hero.stats.projects, href: '#projects' },
  { n: techCount, label: t.hero.stats.techs, href: '#stack' },
];
---

<section class="hero">
  <div class="wrap">
    <p class="kicker rv"><span class="dot" aria-hidden="true"></span>{t.hero.kicker}</p>
    <h1 class="rv" style="--d:80ms">{profile.name}</h1>
    <p class="role rv" style="--d:160ms">{t.hero.role}</p>
    <p class="pitch rv" style="--d:240ms">{t.hero.pitch}</p>
    <div class="cta rv" style="--d:320ms">
      <a class="btn btn-primary" href="#contact">{t.hero.ctaContact}</a>
      {cv && <a class="btn" href={asset(cv)} download>{t.hero.ctaCv} <span aria-hidden="true">↓</span></a>}
    </div>
    <ul class="stats rv" style="--d:400ms">
      {
        stats.map((s) => (
          <li>
            <a href={s.href}>
              <span class="n">
                <span data-count={s.n}>{s.n}</span>
                {s.suffix}
              </span>
              <span class="l">
                {s.label}
                <span class="go" aria-hidden="true">→</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero {
    padding: clamp(72px, 14vw, 150px) 0 clamp(56px, 8vw, 96px);
  }
  .kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--muted);
    border: 1px solid var(--line);
    background: var(--surface);
    padding: 6px 12px;
    border-radius: 999px;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 var(--accent);
    animation: pulse 2.4s infinite;
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 60%, transparent); }
    70%, 100% { box-shadow: 0 0 0 10px transparent; }
  }
  h1 {
    margin-top: 28px;
    font-size: clamp(48px, 11vw, 112px);
    font-weight: 700;
    letter-spacing: -0.045em;
  }
  .role {
    margin-top: 14px;
    font-family: var(--display);
    font-size: clamp(22px, 3.6vw, 34px);
    color: var(--accent);
    font-weight: 500;
  }
  .pitch {
    margin-top: 22px;
    max-width: 58ch;
    font-size: clamp(17px, 2vw, 19px);
    color: var(--muted);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    list-style: none;
    margin: 64px 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
    max-width: 820px;
  }
  @media (max-width: 560px) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .stats a {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 18px 16px 4px 0;
    text-decoration: none;
    color: inherit;
  }
  .n {
    font-family: var(--display);
    font-size: clamp(32px, 6vw, 46px);
    font-weight: 600;
    line-height: 1.15;
    font-variant-numeric: tabular-nums;
    transition: color 0.2s ease;
  }
  .l {
    font-size: 13.5px;
    color: var(--muted);
    transition: color 0.2s ease;
  }
  .go {
    display: inline-block;
    margin-left: 4px;
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }
  .stats a:hover .n,
  .stats a:focus-visible .n {
    color: var(--accent);
  }
  .stats a:hover .l,
  .stats a:focus-visible .l {
    color: var(--fg);
  }
  .stats a:hover .go,
  .stats a:focus-visible .go {
    opacity: 1;
    transform: none;
  }
</style>
